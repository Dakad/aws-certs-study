# OpenTofu / Terraform local data and state can contain secrets.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Plan files written without the .tfplan extension (e.g. -out=tfplan).
tfplan
tfplan.*
*.out
# Variable files may hold account-specific values; commit only the examples.
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local credentials and secret material.
.aws/
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Local OS/editor files.
.DS_Store
